# ============================================================
# .htaccess ukm-toko-theme
# Keamanan + performa untuk shared hosting Apache/LiteSpeed
# ============================================================

# Aktifkan mod_rewrite untuk WordPress.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Redirect HTTP ke HTTPS (paksa SSL).
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect www ke non-www (pilih salah satu, sesuaikan dengan domain).
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# WordPress default rewrite rules.
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# ============================================================
# KEAMANAN: Blokir Eksekusi PHP di Folder Uploads
# ============================================================

<IfModule mod_rewrite.c>
<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pl|py|jsp|asp|htm|shtml|sh|cgi)$">
# Aturan ini diterapkan via direktori .htaccess di folder uploads.
# Lihat wp-content/uploads/.htaccess yang dibuat oleh installer.
</FilesMatch>
</IfModule>

# ============================================================
# KEAMANAN: Batasi Akses ke File Sensitif
# ============================================================

# Blokir akses langsung ke wp-config.php.
<Files wp-config.php>
    Order allow,deny
    Deny from all
</Files>

# Blokir akses ke file .htaccess itu sendiri.
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# Blokir akses ke file .env.
<Files .env>
    Order allow,deny
    Deny from all
</Files>

# Blokir akses ke file readme WordPress (menampilkan versi WP).
<Files readme.html>
    Order allow,deny
    Deny from all
</Files>

<Files license.txt>
    Order allow,deny
    Deny from all
</Files>

# Blokir akses ke file backup dan log.
<FilesMatch "\.(sql|sql\.gz|bak|log|tar|tar\.gz|zip)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ============================================================
# KEAMANAN: Cegah Directory Listing
# ============================================================

Options -Indexes

# ============================================================
# KEAMANAN: Header HTTP
# (Diatur juga via PHP di inc/security.php, ini sebagai backup)
# ============================================================

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Hapus header yang mengekspos informasi server.
    Header unset Server
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# ============================================================
# PERFORMA: Kompresi GZIP/Deflate
# ============================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff font/woff2 application/font-woff application/font-woff2
</IfModule>

# ============================================================
# PERFORMA: Browser Cache Headers
# ============================================================

<IfModule mod_expires.c>
    ExpiresActive On

    # HTML — cache singkat (konten bisa berubah).
    ExpiresByType text/html                 "access plus 1 hour"

    # CSS & JavaScript — cache panjang (versi di query string).
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"

    # Gambar — cache panjang.
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon  "access plus 1 year"

    # Font — cache sangat panjang.
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/font-woff     "access plus 1 year"
    ExpiresByType application/font-woff2    "access plus 1 year"

    # JSON & XML.
    ExpiresByType application/json          "access plus 0 seconds"
    ExpiresByType application/ld+json       "access plus 0 seconds"
    ExpiresByType application/xml           "access plus 0 seconds"
    ExpiresByType text/xml                  "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Cache-Control: immutable untuk aset statis dengan versioning.
    <FilesMatch "\.(css|js|woff|woff2)$">
        Header append Cache-Control "public, immutable"
    </FilesMatch>

    # Jangan cache halaman WordPress yang dinamis.
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ============================================================
# PERFORMA: ETag (nonaktifkan untuk mengurangi overhead)
# ============================================================

<IfModule mod_headers.c>
    Header unset ETag
</IfModule>

FileETag None

# ============================================================
# PERFORMA: Keep-Alive
# ============================================================

<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>
